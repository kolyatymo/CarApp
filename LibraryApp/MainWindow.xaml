<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10">
            <TextBlock Text="Select Authors" Margin="10"/>
            <ComboBox x:Name="Authors" DisplayMemberPath="Name" Loaded="GetAuthors" SelectionChanged="Authors_SelectionChanged"></ComboBox>
            <TextBlock Text="books by select authors" Margin="10"/>
            <ListBox x:Name="ListBooks" Margin="10" DisplayMemberPath="Name"></ListBox>
            <ToolBar>
                <Label>Write Price Book</Label>
                <TextBox Width="100" Name="price"></TextBox>
                <Button Click="Button_Click">Go</Button>
            </ToolBar>
            <ListBox x:Name="ListBooksByPrice" DisplayMemberPath="Name" Margin="10"></ListBox>
            <ToolBar>
                <Label>Write Title Book</Label>
                <TextBox Width="100" Name="NameB"></TextBox>
                <Button Click="Button_Click_1">Go</Button>
            </ToolBar>
            <ListBox x:Name="ListBooksByBookName" DisplayMemberPath="Name" Margin="10"></ListBox>
        </StackPanel>
    </DockPanel>
</Window>
